&NML_CASE
 CASE_TITLE="'nns_npcheck 1h reproducibility check'",
 TIMEZONE="UTC",
 DATE_FORMAT="YMD",
 DATE_REFERENCE="default",
 START_DATE="1998-01-01 00:00:00",
 END_DATE="1998-01-01 01:00:00",
 /
&NML_STARTUP
 STARTUP_TYPE="coldstart",
 STARTUP_FILE="nns_annual_restart.nc",
 STARTUP_UV_TYPE="default",
 STARTUP_TURB_TYPE="default",
 STARTUP_TS_TYPE="constant",
 STARTUP_T_VALS= 10.000000000000000, -99.000000000000000      ,
 STARTUP_S_VALS= 35.000000000000000, -99.000000000000000      ,
 STARTUP_U_VALS= -99.000000000000000     ,
 STARTUP_V_VALS= -99.000000000000000     ,
 STARTUP_DMAX= -99.000000000000000     ,
 /
&NML_IO
